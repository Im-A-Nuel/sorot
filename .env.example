# Everything here is optional for local development.
# With no PANTA_API_KEY the app runs on built-in demo fixtures and labels them "Demo data".

# Panta (verify base URL and routes at docs.panta.market)
PANTA_API_BASE=https://live-api.panta.market/api/v1
PANTA_API_KEY=
# Sorot's attribution id. Sent to Panta as userId so trades are attributed to Sorot.
PANTA_ATTRIBUTION_ID=

# Matching. Without keys the app uses a local hash embedder and a heuristic verifier.
# Any OpenAI-compatible embeddings endpoint works.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Verification uses the Anthropic Messages API.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Applies to a real embedding model only. The local hash embedder uses its own threshold.
MATCH_SIMILARITY_THRESHOLD=0.78

# Database. Neon Postgres in production. Without it the app keeps data in memory.
DATABASE_URL=

# App
CATALOG_SYNC_INTERVAL_SECONDS=300
# Protects GET /api/cron/sync. Vercel Cron sends it as a bearer token. Required in production.
CRON_SECRET=
# Allows ?sim=... failure simulation outside development. Leave empty in production.
ENABLE_SIM=
# Only set this if the API lives somewhere other than this app's /api.
NEXT_PUBLIC_API_URL=
