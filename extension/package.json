{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check-dist.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node tests/e2e.mjs",
    "build:local": "node scripts/build.mjs --api http://localhost:3000/api && node scripts/check-dist.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
